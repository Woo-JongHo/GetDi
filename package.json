{
  "name": "getdi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5545 --strictPort",
    "snapshot": "node scripts/snapshot.mjs",
    "build": "node scripts/snapshot.mjs --if-available && vite build",
    "preview": "vite preview --host localhost --port 5545 --strictPort",
    "crawl": "node crawler/run.mjs",
    "source:import": "node scripts/import_source_snapshot.mjs",
    "source:import:bundle": "node scripts/import_source_snapshot.mjs --bundle",
    "source:repair-assets": "node scripts/repair_source_assets.mjs",
    "source:verify": "node scripts/verify_source_snapshot_corpus.mjs",
    "hermes:canary": "node scripts/hermes_contract_canary.mjs",
    "test": "node --test crawler/*.test.mjs scripts/*.test.mjs server/*.test.mjs .claude/skills/designer-guide/scripts/*.test.mjs src/features/draft/character/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "analyze": "node scripts/analyze_all.mjs",
    "usage": "node scripts/usage_report.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "archiver": "^8.0.0",
    "cheerio": "^1.2.0",
    "image-size": "^2.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "vite": "^6.1.0"
  }
}
